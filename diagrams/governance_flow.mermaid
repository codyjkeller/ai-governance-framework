graph TD
    User[User / Application] -->|"POST /v1/chat/completions over HTTPS"| Auth

    subgraph "Governance Proxy"
        Auth[API key check and rate limit] --> Model[Model allowlist check]
        Model --> Input["Layer 1: Input scan<br/>every message, tool call and field"]
        Input -->|Clean or redacted| Forward[Forward to provider]
        Input -->|Blocked| Reject1[403 returned]
        Output["Layer 5: Output scan<br/>every choice and tool call"]
        Output -->|Blocked| Reject2[502 returned]
        Audit[("Signed, hash-chained audit log")]
    end

    subgraph "External Model Provider"
        Forward --> LLM[LLM Service]
    end

    LLM -->|Reply| Output
    Output -->|Clean or redacted| User

    Auth -.-> Audit
    Model -.-> Audit
    Input -.-> Audit
    Output -.-> Audit
    Audit -.->|Head record after every write| Anchor[("Anchor on another system")]
    Reject1 -.->|Alert| Jira[Jira]
    Reject2 -.->|Alert| Jira

    style Input fill:#e1f5fe,stroke:#01579b
    style Output fill:#ffebee,stroke:#c62828
    style Audit fill:#e8f5e9,stroke:#2e7d32
